# Plantilla para apps/backend/.env.production en el VPS.
# Copia este archivo a apps/backend/.env.production y llena los valores reales
# AHI, directo en el servidor. Nunca lo comitees con valores reales (ya esta
# en .gitignore junto con el resto de .env*).
#
# docker-compose.yml carga este archivo via env_file, y el contenedor corre
# con network_mode: host -- por eso PORT de aqui abajo es tu puerto REAL en
# el VPS (no hay traduccion de puertos de Docker de por medio).
NODE_ENV=production
# Tu puerto asignado. server.js ya lo ata solo a 127.0.0.1 en produccion,
# pero igual DEBE ser el puerto que verificaste libre (sudo ss -tulpn) para
# no chocar con el de otro compañero.
PORT=3005

# --- Base de datos ---
# localhost/127.0.0.1 tanto para "npm run db:migrate" (corre directo en el
# VPS) como para el backend en Docker: con network_mode: host el contenedor
# comparte la red del VPS, asi que es el MISMO 127.0.0.1 en los dos casos.
DB_HOST=localhost
# Verifica el puerto real antes de asumir 3306: sudo ss -tulpn | grep mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=agencia_viajes

# --- Sesiones / JWT ---
# Genera dos secretos nuevos (NO reuses los de tu .env local), p. ej.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=agencia-viajes.idgs8-2.tech

# --- Google OAuth ---
# El redirect URI debe estar dado de alta tal cual en Google Cloud Console
# (Authorized redirect URIs) o Google rechaza el login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agencia-viajes.idgs8-2.tech/api/v1/auth/google/callback

# --- CORS / frontend ---
CORS_ORIGINS=https://agencia-viajes.idgs8-2.tech
FRONTEND_URL=https://agencia-viajes.idgs8-2.tech

# --- SMTP (codigos OTP de login y recuperacion de contrasena) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Viaja <no-responder@viaja.local>

# --- APIs externas ---
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2
GEOAPIFY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Stripe (pagos) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Seguridad ---
SECURITY_ENFORCE=block
