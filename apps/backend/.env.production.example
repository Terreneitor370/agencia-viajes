# Plantilla para apps/backend/.env.production en el VPS.
# Copia este archivo a apps/backend/.env.production y llena los valores reales
# AHI, directo en el servidor. Nunca lo comitees con valores reales (ya esta
# en .gitignore junto con el resto de .env*).
#
# docker-compose.yml carga este archivo via env_file. Las variables que no
# aparecen aqui usan el default de apps/backend/src/config/env.js (por
# ejemplo PORT=3000, que debe quedarse asi: coincide con el EXPOSE del
# Dockerfile y el mapeo de puertos del compose).

NODE_ENV=production

# --- Base de datos ---
# OJO: DB_HOST NO va aqui. docker-compose.yml ya lo fija a
# host.docker.internal (asi el contenedor llega al MySQL del host) y ese
# valor siempre gana sobre lo que pongas en este archivo.
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=agencia_viajes

# --- Sesiones / JWT ---
# Genera dos secretos nuevos (NO reuses los de tu .env local), p. ej.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_DOMAIN=agencia-viajes.idgs8-2.tech

# --- Google OAuth ---
# El redirect URI debe estar dado de alta tal cual en Google Cloud Console
# (Authorized redirect URIs) o Google rechaza el login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agencia-viajes.idgs8-2.tech/api/v1/auth/google/callback

# --- CORS / frontend ---
CORS_ORIGINS=https://agencia-viajes.idgs8-2.tech
FRONTEND_URL=https://agencia-viajes.idgs8-2.tech

# --- SMTP (codigos OTP de login y recuperacion de contrasena) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Viaja <no-responder@viaja.local>

# --- APIs externas ---
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2
GEOAPIFY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Stripe (pagos) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Seguridad ---
SECURITY_ENFORCE=block
