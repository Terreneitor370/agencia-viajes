# =====================================================================
# Copia este archivo como `.env` y rellena los valores.
# El archivo `.env` NUNCA se sube a Git (ya esta en .gitignore).
# Si alguna vez se sube por error: rota TODAS las claves. Borrar el commit
# no basta, el historial de Git es publico para quien clone el repositorio.
# =====================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --------------------------- Base de datos ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=agencia_app
DB_PASSWORD=cambiame
DB_NAME=agencia_viajes

# --------------------------- Sesiones --------------------------------
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deben ser DISTINTOS entre si y tener al menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost

# --------------------------- OAuth Google ----------------------------
# Consola: https://console.cloud.google.com/apis/credentials
# Tipo de credencial: "ID de cliente de OAuth 2.0" -> "Aplicacion web".
# URI de redireccion autorizado: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --------------------------- CORS ------------------------------------
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------ APIs externas (SOLO backend) ---------------------
# Estas claves jamas se copian al frontend. Vite expone al navegador todo lo
# que empiece con VITE_, asi que una clave ahi es una clave publicada.

# Duffel (vuelos) - modo prueba gratuito, token con prefijo duffel_test_
# https://app.duffel.com/  ->  Developers > Access tokens
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2

# Geoapify (hospedaje, experiencias y geocodificacion) - 3000 creditos/dia gratis
# https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Unsplash (imagenes de destino) - opcional
UNSPLASH_ACCESS_KEY=

# ------------------ Postura de seguridad en runtime -------------------
# block   = las violaciones detectadas cortan la peticion (recomendado)
# monitor = solo se registran (util si algo bloquea de mas durante la demo)
SECURITY_ENFORCE=block
EXTERNAL_CACHE_TTL_SECONDS=3600
