# =====================================================================
# ADVERTENCIA: Vite inyecta en el BUNDLE toda variable que empiece con VITE_.
# Cualquier persona puede leerlas abriendo las herramientas de desarrollo.
#
# Por lo tanto: NUNCA pongas aqui claves de Duffel, Geoapify, Google
# client_secret ni secretos JWT. Esas viven exclusivamente en
# apps/backend/.env y el navegador nunca las ve.
#
# En este proyecto el frontend no necesita ninguna clave: todas las llamadas
# a terceros pasan por nuestro backend.
# =====================================================================

# Ruta base de la API. Con el proxy de Vite se deja relativa.
VITE_API_URL=/api/v1
VITE_APP_NAME=Agencia de Viajes
